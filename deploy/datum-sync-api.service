[Unit]
Description=Datum-Sync API server
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/datum-sync
EnvironmentFile=/home/ubuntu/datum-sync/.env
ExecStart=/home/ubuntu/datum-sync/.venv/bin/python -m datum_sync.api
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
