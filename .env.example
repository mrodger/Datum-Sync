# Database
DATABASE_URL=postgresql://datumsync:datumsync_local@localhost:5435/datumsync

# Server
HOST=0.0.0.0
PORT=8200

# The origin clients actually reach. Required -- the server refuses to start
# without it, because it is the OAuth issuer and the access-token audience, and
# a guessed default mints tokens no client can use. Behind a tunnel or reverse
# proxy this is the public name, not the local bind address.
#
# Note: an exported PUBLIC_URL beats this file. python-dotenv does not override
# variables already in the environment.
PUBLIC_URL=http://localhost:8200

# Development only. Set to the exact word "off" to serve every request as an
# administrator with no credential -- useful for hand-testing the UI without
# managing accounts. Left commented out deliberately: this file gets copied, and
# the one thing that must not travel with it is disabled authentication.
#
# Two things stop it reaching further than the machine it is set on. The server
# refuses to start unless HOST is loopback, and -- because `uvicorn --host` never
# consults HOST -- every request is also checked against the connecting socket's
# own address, which no header can forge. So this needs HOST=127.0.0.1 as well.
#
# DATUM_SYNC_AUTH=off
# HOST=127.0.0.1

# Paths (relative to repo root unless absolute)
REPOSITORIES_PATH=./repositories
RESOURCES_PATH=./resources
DATA_PATH=./data
