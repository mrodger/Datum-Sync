# Database
DATABASE_URL=postgresql://datumsync:datumsync_local@localhost:5435/datumsync

# Server
HOST=0.0.0.0
PORT=8200

# The origin clients actually reach. Required -- the server refuses to start
# without it, because it is the OAuth issuer and the access-token audience, and
# a guessed default mints tokens no client can use. Behind a tunnel or reverse
# proxy this is the public name, not the local bind address.
#
# Note: an exported PUBLIC_URL beats this file. python-dotenv does not override
# variables already in the environment.
PUBLIC_URL=http://localhost:8200

# Paths (relative to repo root unless absolute)
REPOSITORIES_PATH=./repositories
RESOURCES_PATH=./resources
DATA_PATH=./data
